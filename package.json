{
  "name": "airlock-proxy",
  "version": "0.1.0",
  "description": "Human-in-the-loop approval proxy for outbound requests made during a Claude Code session.",
  "type": "module",
  "bin": {
    "airlock": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.mkdirSync('dist/public',{recursive:true});fs.copyFileSync('src/public/index.html','dist/public/index.html')\"",
    "prepare": "npm run build",
    "start": "node dist/cli.js start",
    "dev": "node --experimental-strip-types src/cli.ts start"
  },
  "keywords": [
    "claude-code",
    "ai-agents",
    "mcp",
    "proxy",
    "human-in-the-loop",
    "ai-safety",
    "guardrails",
    "approval",
    "firewall",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahulbansal16/airlock.git"
  },
  "homepage": "https://github.com/rahulbansal16/airlock#readme",
  "bugs": {
    "url": "https://github.com/rahulbansal16/airlock/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.11",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
